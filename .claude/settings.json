{
  "permissions": {
    "allow": [
      "Bash(./verify *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git push -u origin q-*)",
      "Bash(git push origin q-*)",
      "Bash(gh pr create*)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin --force*)",
      "Bash(git push origin -f*)",
      "Bash(git push --delete*)",
      "Bash(git push origin --delete*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Read(./.env*)",
      "Read(./**/secrets*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pretool-deny.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/posttool-dirty.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.sh" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.sh" }
        ]
      }
    ]
  }
}
