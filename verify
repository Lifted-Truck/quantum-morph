#!/usr/bin/env bash
# verify — oracle dispatcher. The harness's only interface to project QC.
# Usage: ./verify fast | full | report
# Contract: exit 0 = green, nonzero = red. Writes .harness/last-verify.json.
set -uo pipefail

TARGET="${1:-fast}"
HARNESS_DIR=".harness"
mkdir -p "$HARNESS_DIR"

# Kit-owned gates: record, leak_gate, kit_integrity. A repo missing this file
# is not a lesser repo, it is an UNGATED one, so failing loudly beats degrading
# quietly — a silently skipped privacy gate is exactly the shape of bug the
# gate exists to prevent.
if [ -r .kit/kit-gates.sh ]; then
  . .kit/kit-gates.sh
else
  echo "verify: .kit/kit-gates.sh missing — run kit_sync.py (gates cannot be skipped)" >&2
  exit 1
fi

fast() {
  # ---- Layer-0: seconds, not minutes. CI-blocking. -------------------------
  local ok=0
  kit_integrity || ok=1   # kit-owned files match .kit/MANIFEST
  leak_gate || ok=1          # privacy gate: kit-core, keep it first

  # Structure sanity: the files the charter/ROADMAP point at must exist.
  local f
  for f in CLAUDE.md ROADMAP.md README.md DECISIONS.md INDEX.md LIBRARY.md \
           project.manifest.json docs/specs/QM-0-core-engine-spec.md \
           docs/specs/QM-1-m4l-device-spec.md \
           docs/specs/QM-2-instrument-integration-spec.md; do
    [ -f "$f" ] || { echo "verify: MISSING $f" >&2; ok=1; }
  done

  # Manifest must parse (node is the project toolchain — engine is JS).
  node -e 'JSON.parse(require("fs").readFileSync("project.manifest.json","utf8"))' \
    || { echo "verify: project.manifest.json is not valid JSON" >&2; ok=1; }

  # Knowledge-loop atomicity: every INDEX pointer resolves in LIBRARY.
  local id
  for id in $(grep -oE 'L[0-9]{4}' INDEX.md 2>/dev/null | sort -u); do
    grep -q "\[$id\]" LIBRARY.md || { echo "verify: INDEX $id has no LIBRARY entry" >&2; ok=1; }
  done

  # Engine suite. The glob is load-bearing: `node --test tests/` resolves the
  # DIRECTORY as a module path on Node 24 and dies with MODULE_NOT_FOUND before
  # running anything. Pass the files.
  if ls tests/*.test.mjs >/dev/null 2>&1; then
    node --test tests/*.test.mjs || ok=1
  fi

  return "$ok"
}

full() {
  fast || return $?
  # ---- Layer-E: the whole gate. Run before closing a queue item. -----------
  # P0/P1: full == fast (ROADMAP §Oracle). Device-layer attended checks
  # (loads in Live 12, docs/device-checklist.md) are added at P2.
  return 0
}

case "$TARGET" in
  fast)   fast;  record fast  $? ;;
  full)   full;  record full  $? ;;
  report) cat "$HARNESS_DIR/last-verify.json" 2>/dev/null || { echo '{"target":null,"exit":null}'; exit 1; } ;;
  *)      echo "usage: ./verify fast|full|report" >&2; exit 64 ;;
esac
